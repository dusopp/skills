{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|PowerShell|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.ps1\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
